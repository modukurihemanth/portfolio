@* Projects - Career Timeline. Each entry expands/collapses natively via <details>, no JS needed. *@

<div class="timeline">

    @foreach (var (job, index) in Experience.Select((j, i) => (j, i)))
    {
        <div class="timeline-item reveal" style="transition-delay:@(index * 0.08)s">
            <div class="timeline-marker" style="@(job.MarkerBackground is not null ? $"background:{job.MarkerBackground}" : "")">
                <img src="@job.LogoSrc" class="timeline-logo" alt="@job.Client" />
            </div>
            <details class="timeline-card" open="@(index == 0)">
                <summary>
                    <div class="timeline-summary-text">
                        <h3>@job.Client</h3>
                        <span class="timeline-role">@job.Role</span>
                        <span class="timeline-period">@job.Period</span>
                    </div>
                    <span class="timeline-chevron" aria-hidden="true"></span>
                </summary>
                <ul class="timeline-bullets">
                    @foreach (var bullet in job.Bullets)
                    {
                        <li>@bullet</li>
                    }
                </ul>
            </details>
        </div>
    }

</div>

@code {

